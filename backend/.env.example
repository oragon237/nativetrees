# Copy to .env and fill in. Never commit .env.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/katutubong_puno
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
STORAGE_DRIVER=local
# For future S3-compatible storage (Phase 1 uses local disk via same interface):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# --- Beta / production (Hostinger VPS) ---
# Set PG_SSL=true only for managed Postgres with TLS (Neon/Supabase).
# Same-machine installs: leave unset (localhost, no TLS).
# PG_SSL=
# Comma-separated public origins allowed to call the API (web apps).
# CORS_ORIGINS=https://app.yourdomain.com,https://www.clientwebsitedemo.com
# Real email delivery (omit entirely to log instead):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
# Push delivery provider hook:
# PUSH_ENABLED=true
